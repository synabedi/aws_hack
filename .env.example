# Copy to .env and fill in. Never commit .env.
# Storage backend: "local" (JSON files under data/local) or "aws" (DynamoDB + S3)
JALMAAPI_BACKEND=local
JALMAAPI_TABLE_PREFIX=jalmaapi
JALMAAPI_BUCKET=jalmaapi-<account-id>
JALMAAPI_SNS_TOPIC_ARN=
AWS_REGION=ap-south-1
# Bedrock model for verifier, justifications and advisories
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# If unset, Act falls back to deterministic templates and no LLM calls are made
JALMAAPI_USE_BEDROCK=false
# Public base URL used in approval links
JALMAAPI_PUBLIC_URL=http://localhost:8000
